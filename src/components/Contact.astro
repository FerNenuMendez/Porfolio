---
---
<section id="contact" class="py-24 px-6 max-w-6xl mx-auto relative z-10 scroll-mt-20 flex-grow flex flex-col justify-between">
  <div class="reveal w-full">
    <!-- Section Title -->
    <div class="flex flex-col mb-16 items-center text-center">
      <span class="text-xs uppercase font-extrabold tracking-widest text-accent-purple mb-2">Hablemos</span>
      <h2 class="font-outfit text-3xl md:text-4xl font-extrabold text-white">Ponte en Contacto</h2>
      <div class="w-12 h-1 bg-gradient-to-r from-accent-purple to-accent-cyan mt-3 rounded-full"></div>
      <p class="font-inter text-gray-400 text-sm md:text-base max-w-md mt-6">
        ¿Tienes un proyecto en mente, buscas un desarrollador backend para tu equipo o simplemente quieres charlar? Escríbeme.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto mb-20">
      <!-- LinkedIn Card -->
      <a 
        href="https://linkedin.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="glass p-6 rounded-2xl border-white/5 hover:border-accent-cyan/35 hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
      >
        <div class="w-12 h-12 rounded-xl bg-accent-cyan/10 flex items-center justify-center text-accent-cyan mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </div>
        <span class="font-outfit font-bold text-white text-base mb-1">LinkedIn</span>
        <span class="font-inter text-xs text-gray-400">Conectemos profesionalmente</span>
      </a>

      <!-- GitHub Card -->
      <a 
        href="https://github.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="glass p-6 rounded-2xl border-white/5 hover:border-accent-purple/35 hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
      >
        <div class="w-12 h-12 rounded-xl bg-accent-purple/10 flex items-center justify-center text-accent-purple mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <span class="font-outfit font-bold text-white text-base mb-1">GitHub</span>
        <span class="font-inter text-xs text-gray-400">Revisa mis repositorios</span>
      </a>

      <!-- WhatsApp Card -->
      <a 
        href="https://wa.me/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="glass p-6 rounded-2xl border-white/5 hover:border-emerald-500/35 hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
      >
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.488 1.449 5.412 1.451 5.58 0 10.125-4.542 10.128-10.122.002-2.702-1.05-5.242-2.957-7.15C17.323 1.425 14.787.375 12.083.375c-5.583 0-10.13 4.544-10.133 10.125-.001 1.895.493 3.748 1.429 5.348l-.93 3.393 3.474-.912zm13.1-6.177c-.366-.183-2.165-1.069-2.5-1.192-.333-.122-.577-.183-.82.183-.243.366-.943 1.192-1.157 1.437-.213.244-.427.275-.793.092-.366-.183-1.543-.569-2.94-1.815-1.087-.97-1.821-2.166-2.034-2.533-.213-.366-.023-.564.16-.747.165-.165.366-.427.549-.64.183-.213.244-.366.366-.61.122-.244.061-.458-.03-.64-.092-.183-.82-1.983-1.125-2.716-.297-.717-.599-.619-.82-.63l-.702-.01c-.244-.01-.64.091-.974.458-.335.366-1.28 1.251-1.28 3.05 0 1.799 1.31 3.538 1.493 3.781.183.244 2.578 3.937 6.242 5.518.871.376 1.551.6 2.082.769.875.278 1.672.239 2.3.145.7-.104 2.166-.885 2.47-1.739.305-.853.305-1.586.213-1.739-.092-.153-.335-.244-.702-.427z"/>
          </svg>
        </div>
        <span class="font-outfit font-bold text-white text-base mb-1">WhatsApp</span>
        <span class="font-inter text-xs text-gray-400">Escríbeme directamente</span>
      </a>

      <!-- Email Card -->
      <a 
        href="mailto:fer@example.com" 
        class="glass p-6 rounded-2xl border-white/5 hover:border-accent-purple/35 hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
      >
        <div class="w-12 h-12 rounded-xl bg-accent-purple/10 flex items-center justify-center text-accent-purple mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <span class="font-outfit font-bold text-white text-base mb-1">Email</span>
        <span class="font-inter text-xs text-gray-400">fer@example.com</span>
      </a>
    </div>
  </div>

  <!-- Footer -->
  <footer class="w-full pt-12 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 font-inter gap-4">
    <div>
      <p>© 2026 Fer. Todos los derechos reservados.</p>
    </div>
    <div class="flex items-center gap-2">
      <span>Desarrollado con</span>
      <span class="text-orange-500 font-bold">Astro</span>
      <span>y</span>
      <span class="text-teal-400 font-bold">Tailwind CSS</span>
    </div>
  </footer>
</section>
