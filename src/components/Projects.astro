---

---

<section
  id="projects"
  class="py-24 px-6 max-w-6xl mx-auto relative z-10 scroll-mt-20"
>
  <div class="reveal">
    <!-- Section Title -->
    <div class="flex flex-col mb-16">
      <span
        class="text-xs uppercase font-extrabold tracking-widest text-accent-cyan mb-2"
        >Mi Portafolio</span
      >
      <h2 class="font-outfit text-3xl md:text-4xl font-extrabold text-white">
        Proyectos Destacados
      </h2>
      <div
        class="w-12 h-1 bg-gradient-to-r from-accent-purple to-accent-cyan mt-3 rounded-full"
      >
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Project 1: Cannapp -->
      <div
        class="glass rounded-3xl overflow-hidden border-white/5 hover:border-accent-purple/30 group hover:-translate-y-2 transition-all duration-500 flex flex-col justify-between h-full"
      >
        <!-- Card Header / Visual Accent -->
        <div
          class="h-48 bg-gradient-to-br from-accent-purple/20 to-bg-dark border-b border-white/5 p-6 flex flex-col justify-between relative overflow-hidden"
        >
          <div
            class="absolute -right-10 -bottom-10 w-32 h-32 bg-accent-purple/10 rounded-full blur-2xl"
          >
          </div>

          <!-- Category Badge & GitHub icon -->
          <div class="flex items-center justify-between z-10">
            <span
              class="text-xs font-bold font-mono tracking-wider text-accent-purple uppercase bg-accent-purple/10 px-3 py-1 rounded-full border border-accent-purple/20"
            >
              API / Backend
            </span>
            <div class="flex gap-2">
              <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-full bg-bg-dark/80 text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all duration-300"
                aria-label="GitHub Repository"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Big Project Logo/Text Mock -->
          <div class="z-10 flex items-center gap-3">
            <div
              class="w-12 h-12 rounded-2xl bg-bg-dark border border-accent-purple/20 flex items-center justify-center font-outfit text-white font-extrabold text-xl shadow-lg"
            >
              Tr
            </div>
            <h3
              class="font-outfit font-black text-2xl text-white tracking-tight group-hover:text-accent-purple transition-colors"
            >
              TravelApp
            </h3>
          </div>
        </div>

        <!-- Card Body -->
        <div class="p-6 flex-grow flex flex-col justify-between">
          <div class="space-y-4">
            <p class="font-inter text-sm text-gray-400 leading-relaxed">
              API robusta desarrollada con <strong class="text-white"
                >NestJS</strong
              > y <strong class="text-white">MongoDB</strong> diseñada para la gestión
              integral de datos y registros en entidades organizacionales de salud.
            </p>
            <div
              class="p-3.5 rounded-xl bg-white/2 border border-white/5 text-xs text-gray-400 space-y-1"
            >
              <div
                class="flex items-center gap-1.5 text-accent-purple font-semibold"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
                <span>Foco del Backend</span>
              </div>
              <p>
                Arquitectura limpia apoyada en esquemas de mongoose, decorators
                personalizados y <strong class="text-gray-200"
                  >Validation Pipes</strong
                > para sanitización de DTOs en tiempo real.
              </p>
            </div>
          </div>

          <!-- Badges & Tech Footer -->
          <div class="mt-6 pt-6 border-t border-white/5 space-y-4">
            <div class="flex flex-wrap gap-1.5">
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >NestJS</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >MongoDB</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >Mongoose</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >Validation Pipes</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2: Quiendijoque -->
      <div
        class="glass rounded-3xl overflow-hidden border-white/5 hover:border-accent-cyan/30 group hover:-translate-y-2 transition-all duration-500 flex flex-col justify-between h-full"
      >
        <!-- Card Header / Visual Accent -->
        <div
          class="h-48 bg-gradient-to-br from-accent-cyan/20 to-bg-dark border-b border-white/5 p-6 flex flex-col justify-between relative overflow-hidden"
        >
          <div
            class="absolute -right-10 -bottom-10 w-32 h-32 bg-accent-cyan/10 rounded-full blur-2xl"
          >
          </div>

          <!-- Category Badge & GitHub icon -->
          <div class="flex items-center justify-between z-10">
            <span
              class="text-xs font-bold font-mono tracking-wider text-accent-cyan uppercase bg-accent-cyan/10 px-3 py-1 rounded-full border border-accent-cyan/20"
            >
              Mobile App
            </span>
            <div class="flex gap-2">
              <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-full bg-bg-dark/80 text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all duration-300"
                aria-label="GitHub Repository"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Big Project Logo/Text Mock -->
          <div class="z-10 flex items-center gap-3">
            <div
              class="w-12 h-12 rounded-2xl bg-bg-dark border border-accent-cyan/20 flex items-center justify-center font-outfit text-white font-extrabold text-xl shadow-lg"
            >
              QD
            </div>
            <h3
              class="font-outfit font-black text-2xl text-white tracking-tight group-hover:text-accent-cyan transition-colors"
            >
              Quiendijoque
            </h3>
          </div>
        </div>

        <!-- Card Body -->
        <div class="p-6 flex-grow flex flex-col justify-between">
          <div class="space-y-4">
            <p class="font-inter text-sm text-gray-400 leading-relaxed">
              Aplicación móvil interactiva de preguntas y respuestas y desafíos
              rápidos, desarrollada para lograr la máxima fluidez en
              dispositivos móviles.
            </p>
            <div
              class="p-3.5 rounded-xl bg-white/2 border border-white/5 text-xs text-gray-400 space-y-1"
            >
              <div
                class="flex items-center gap-1.5 text-accent-cyan font-semibold"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                  ></path>
                </svg>
                <span>Foco del Cliente</span>
              </div>
              <p>
                Desarrollada con <strong class="text-white">React Native</strong
                > y <strong class="text-white">Expo</strong>. Implementa
                gestores de estado ágiles y animaciones reactivas para una UX de
                trivias dinámica.
              </p>
            </div>
          </div>

          <!-- Badges & Tech Footer -->
          <div class="mt-6 pt-6 border-t border-white/5 space-y-4">
            <div class="flex flex-wrap gap-1.5">
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >React Native</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >Expo</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >JavaScript</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >Mobile UX</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Project 3: Bot Monitor -->
      <div
        class="glass rounded-3xl overflow-hidden border-white/5 hover:border-accent-purple/30 group hover:-translate-y-2 transition-all duration-500 flex flex-col justify-between h-full"
      >
        <!-- Card Header / Visual Accent -->
        <div
          class="h-48 bg-gradient-to-br from-accent-purple/20 to-bg-dark border-b border-white/5 p-6 flex flex-col justify-between relative overflow-hidden"
        >
          <div
            class="absolute -right-10 -bottom-10 w-32 h-32 bg-accent-purple/10 rounded-full blur-2xl"
          >
          </div>

          <!-- Category Badge & GitHub icon -->
          <div class="flex items-center justify-between z-10">
            <span
              class="text-xs font-bold font-mono tracking-wider text-accent-purple uppercase bg-accent-purple/10 px-3 py-1 rounded-full border border-accent-purple/20"
            >
              Automation / Bot
            </span>
            <div class="flex gap-2">
              <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-full bg-bg-dark/80 text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all duration-300"
                aria-label="GitHub Repository"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Big Project Logo/Text Mock -->
          <div class="z-10 flex items-center gap-3">
            <div
              class="w-12 h-12 rounded-2xl bg-bg-dark border border-accent-purple/20 flex items-center justify-center font-outfit text-white font-extrabold text-xl shadow-lg"
            >
              BM
            </div>
            <h3
              class="font-outfit font-black text-2xl text-white tracking-tight group-hover:text-accent-purple transition-colors"
            >
              Bot Monitor
            </h3>
          </div>
        </div>

        <!-- Card Body -->
        <div class="p-6 flex-grow flex flex-col justify-between">
          <div class="space-y-4">
            <p class="font-inter text-sm text-gray-400 leading-relaxed">
              Bot programado para realizar scraping periódico automatizado,
              evaluar cambios críticos en portales web y emitir alertas
              inmediatas.
            </p>
            <div
              class="p-3.5 rounded-xl bg-white/2 border border-white/5 text-xs text-gray-400 space-y-1"
            >
              <div
                class="flex items-center gap-1.5 text-accent-purple font-semibold"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <span>Foco en Automatización</span>
              </div>
              <p>
                Desarrollado con <strong class="text-white">Playwright</strong> para
                navegación headless. Orquestado con <strong class="text-white"
                  >GitHub Actions</strong
                > mediante tareas programadas (cron) y alertas conectadas a la API
                de <strong class="text-gray-200">Telegram</strong>.
              </p>
            </div>
          </div>

          <!-- Badges & Tech Footer -->
          <div class="mt-6 pt-6 border-t border-white/5 space-y-4">
            <div class="flex flex-wrap gap-1.5">
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >Playwright</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >GitHub Actions</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >Telegram API</span
              >
              <span
                class="text-[10px] font-mono font-bold badge-tech px-2.5 py-1 rounded-md"
                >Node.js</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Otros Proyectos Sub-section -->
    <div class="mt-24">
      <div class="flex flex-col mb-12">
        <span
          class="text-xs uppercase font-extrabold tracking-widest text-accent-purple mb-2"
          >Más Trabajos</span
        >
        <h3 class="font-outfit text-2xl md:text-3xl font-extrabold text-white">
          Otros Proyectos
        </h3>
        <div
          class="w-12 h-1 bg-gradient-to-r from-accent-purple to-accent-cyan mt-3 rounded-full"
        >
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Project: El Baresico -->
        <div
          class="glass p-6 rounded-2xl border-white/5 hover:border-accent-cyan/25 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between h-full group"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span
                class="text-[10px] font-bold font-mono tracking-wider text-accent-cyan uppercase bg-accent-cyan/10 px-2 py-0.5 rounded-full border border-accent-cyan/10"
              >
                Web
              </span>
              <a
                href="https://elbaresico.es/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-500 hover:text-white transition-colors"
                aria-label="Visitar El Baresico"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path>
                </svg>
              </a>
            </div>
            <h4
              class="font-outfit font-bold text-white text-lg mb-2 group-hover:text-accent-cyan transition-colors"
            >
              El Baresico
            </h4>
            <p class="font-inter text-xs text-gray-400 leading-relaxed mb-4">
              Catálogo digital interactivo desarrollado para la optimización de
              comandas y visualización de menús gastronómicos locales.
            </p>
          </div>
          <div class="flex flex-wrap gap-1 mt-auto">
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >React</span
            >
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >Astro</span
            >
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >Tailwind</span
            >
          </div>
        </div>

        <!-- Project: Domi Mau -->
        <div
          class="glass p-6 rounded-2xl border-white/5 hover:border-accent-purple/25 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between h-full group"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span
                class="text-[10px] font-bold font-mono tracking-wider text-accent-purple uppercase bg-accent-purple/10 px-2 py-0.5 rounded-full border border-accent-purple/10"
              >
                Web
              </span>
              <a
                href="https://domi-mau.es/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-500 hover:text-white transition-colors"
                aria-label="Visitar Domi Mau"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path>
                </svg>
              </a>
            </div>
            <h4
              class="font-outfit font-bold text-white text-lg mb-2 group-hover:text-accent-purple transition-colors"
            >
              Domi Mau
            </h4>
            <p class="font-inter text-xs text-gray-400 leading-relaxed mb-4">
              Sitio web portafolio y escaparate digital diseñado a medida para
              servicios artísticos y profesionales independientes.
            </p>
          </div>
          <div class="flex flex-wrap gap-1 mt-auto">
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >HTML5</span
            >
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >CSS3</span
            >
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >JS ES6</span
            >
          </div>
        </div>

        <!-- Project: Equitania -->
        <div
          class="glass p-6 rounded-2xl border-white/5 hover:border-accent-cyan/25 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between h-full group"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span
                class="text-[10px] font-bold font-mono tracking-wider text-accent-cyan uppercase bg-accent-cyan/10 px-2 py-0.5 rounded-full border border-accent-cyan/10"
              >
                Web / Platform
              </span>
              <a
                href="https://equitania.es/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-500 hover:text-white transition-colors"
                aria-label="Visitar Equitania"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path>
                </svg>
              </a>
            </div>
            <h4
              class="font-outfit font-bold text-white text-lg mb-2 group-hover:text-accent-cyan transition-colors"
            >
              Equitania
            </h4>
            <p class="font-inter text-xs text-gray-400 leading-relaxed mb-4">
              Plataforma corporativa y de gestión de servicios ecuestres,
              eventos y reservas de actividades hípicas.
            </p>
          </div>
          <div class="flex flex-wrap gap-1 mt-auto">
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >React</span
            >
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >Tailwind</span
            >
            <span class="text-[9px] font-mono badge-tech px-2 py-0.5 rounded"
              >Vite</span
            >
          </div>
        </div>

        <!-- Project: RMG Ciudadanías -->
        <div
          class="glass p-6 rounded-2xl border-white/5 hover:border-accent-purple/25 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between h-full group"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
