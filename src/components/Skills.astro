---
---
<section id="skills" class="py-24 px-6 max-w-6xl mx-auto relative z-10 scroll-mt-20">
  <div class="reveal">
    <!-- Section Title -->
    <div class="flex flex-col mb-16">
      <span class="text-xs uppercase font-extrabold tracking-widest text-accent-purple mb-2">Mi Caja de Herramientas</span>
      <h2 class="font-outfit text-3xl md:text-4xl font-extrabold text-white">Stack Tecnológico</h2>
      <div class="w-12 h-1 bg-gradient-to-r from-accent-purple to-accent-cyan mt-3 rounded-full"></div>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Category 1: Backend -->
      <div class="glass p-8 rounded-3xl border-white/5 relative group hover:border-accent-purple/30 transition-all duration-500 flex flex-col justify-between">
        <div>
          <!-- Title & Icon -->
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 rounded-xl bg-accent-purple/10 flex items-center justify-center text-accent-purple">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
            </div>
            <h3 class="font-outfit font-extrabold text-xl text-white">Backend</h3>
          </div>
          
          <!-- Skill Items -->
          <div class="space-y-4">
            <!-- Node.js -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-green-500" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2L3.5 6.9v9.8L12 22l8.5-4.9V6.9L12 2zm-1 15.4c-2.3-.3-4-1.8-4-4.2h1.8c0 1.5.9 2.5 2.2 2.5s2.2-1 2.2-2.2c0-2.3-3.2-2.1-3.2-5.4 0-1.8 1.2-3.1 3-3.3v1.3c-1.3.2-2 1-2 2.1 0 1.9 3.2 2 3.2 5.3 0 2.2-1.7 3.7-4.2 3.9v1.3z" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">Node.js</span>
              </div>
              <span class="text-xs font-mono text-gray-500">Avanzado</span>
            </div>

            <!-- Express.js -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="8" rx="2" />
                  <rect x="2" y="14" width="20" height="8" rx="2" />
                  <line x1="6" y1="6" x2="6.01" y2="6" stroke-linecap="round" />
                  <line x1="6" y1="18" x2="6.01" y2="18" stroke-linecap="round" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">Express</span>
              </div>
              <span class="text-xs font-mono text-gray-500">Avanzado</span>
            </div>

            <!-- NestJS -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-red-500" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">NestJS</span>
              </div>
              <span class="text-xs font-mono text-gray-400">Especialidad</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Category 2: Frontend -->
      <div class="glass p-8 rounded-3xl border-white/5 relative group hover:border-accent-cyan/30 transition-all duration-500 flex flex-col justify-between">
        <div>
          <!-- Title & Icon -->
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 rounded-xl bg-accent-cyan/10 flex items-center justify-center text-accent-cyan">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-outfit font-extrabold text-xl text-white">Frontend</h3>
          </div>
          
          <!-- Skill Items -->
          <div class="space-y-4">
            <!-- React -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-cyan-400 animate-spin" style="animation-duration: 12s;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <ellipse rx="10" ry="4.5" cx="12" cy="12" transform="rotate(0 12 12)"/>
                  <ellipse rx="10" ry="4.5" cx="12" cy="12" transform="rotate(60 12 12)"/>
                  <ellipse rx="10" ry="4.5" cx="12" cy="12" transform="rotate(120 12 12)"/>
                  <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">React</span>
              </div>
              <span class="text-xs font-mono text-gray-500">Competente</span>
            </div>

            <!-- Astro -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-orange-500" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2s-1 2-2 4-4 2-5 4 0 5 3 6c-2-2-1-5 1-6s3-2 4-5c1 3 2 4 4 5s3 4 1 6c3-1 4-4 3-6s-3-2-5-4-2-4-2-4z" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">Astro</span>
              </div>
              <span class="text-xs font-mono text-gray-400">Lighthouses</span>
            </div>

            <!-- Tailwind CSS -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-teal-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 6.5c2.76 0 5-2.24 5-5H7c0 2.76 2.24 5 5 5zm0 11c-2.76 0-5 2.24-5 5h10c0-2.76-2.24-5-5-5zm-5.5-5.5c0 2.76 2.24 5 5 5v-10c-2.76 0-5 2.24-5 5zm11 0c0-2.76-2.24-5-5-5v10c2.76 0 5-2.24 5-5z" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">Tailwind CSS</span>
              </div>
              <span class="text-xs font-mono text-gray-500">Avanzado</span>
            </div>

            <!-- JavaScript/TypeScript -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M2 2h20v20H2V2zm11.3 12.3c0-1 .4-1.8 1.1-2.4.7-.6 1.7-.9 2.8-.9s2.1.3 2.8.9c.7.6 1.1 1.4 1.1 2.4h-1.8c0-.6-.2-1-.5-1.3-.3-.3-.8-.4-1.5-.4s-1.2.1-1.5.4c-.3.3-.5.7-.5 1.3 0 1 .8 1.6 2.3 2 1.6.4 2.8.9 3.5 1.6.7.7 1 1.6 1 2.8 0 1.2-.4 2.1-1.3 2.8-.8.6-2 .9-3.4.9s-2.6-.3-3.4-1c-.8-.7-1.2-1.6-1.2-2.8h1.8c0 .8.3 1.3.8 1.7.5.3 1.2.5 2 .5.8 0 1.4-.2 1.8-.5.4-.3.6-.8.6-1.4 0-.8-.7-1.3-2.1-1.7-1.7-.4-2.9-1-3.6-1.7-.6-.6-.9-1.5-.9-2.6zM3.4 17.5h1.8v-7h-1.8V9h5.4v1.5H7.1v7H8.9v1.5H3.4v-1.5z" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">TypeScript</span>
              </div>
              <span class="text-xs font-mono text-gray-400">Esencial</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Category 3: DB & Tools -->
      <div class="glass p-8 rounded-3xl border-white/5 relative group hover:border-accent-purple/30 transition-all duration-500 flex flex-col justify-between">
        <div>
          <!-- Title & Icon -->
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 rounded-xl bg-accent-purple/10 flex items-center justify-center text-accent-purple">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="font-outfit font-extrabold text-xl text-white">Herramientas</h3>
          </div>
          
          <!-- Skill Items -->
          <div class="space-y-4">
            <!-- MongoDB -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-green-600" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 1.5c-.3 0-.6.2-.8.5C9.4 6.7 8 11.5 8 13.5c0 2.5 1.8 4 4 4s4-1.5 4-4c0-2-1.4-6.8-3.2-11.5-.2-.3-.5-.5-.8-.5zm0 1.8c.8 2.5 2.5 7.5 2.5 10.2 0 1.5-1 2.5-2.5 2.5s-2.5-1-2.5-2.5c0-2.7 1.7-7.7 2.5-10.2zM12 18.5c-2.8 0-5 2.2-5 5h10c0-2.8-2.2-5-5-5z" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">MongoDB</span>
              </div>
              <span class="text-xs font-mono text-gray-500">MERN Focus</span>
            </div>

            <!-- Vercel -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2L2 22h20L12 2z" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">Vercel / Deploy</span>
              </div>
              <span class="text-xs font-mono text-gray-500">Hosting</span>
            </div>

            <!-- GitHub Actions & Git -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="6" height="6" rx="1" />
                  <rect x="16" y="8" width="6" height="6" rx="1" />
                  <rect x="2" y="16" width="6" height="6" rx="1" />
                  <path d="M5 8v8M8 5h6a2 2 0 012 2v1" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">GitHub Actions</span>
              </div>
              <span class="text-xs font-mono text-gray-400">CI/CD</span>
            </div>

            <!-- Playwright -->
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/2 border border-white/5 hover:bg-white/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" />
                  <path d="M12 6v12M8 10h8M8 14h8" />
                </svg>
                <span class="font-inter text-sm font-semibold text-gray-200">Playwright</span>
              </div>
              <span class="text-xs font-mono text-gray-400">Automation</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
