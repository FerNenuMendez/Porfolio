---
---
<section id="hero" class="relative min-h-[110vh] md:min-h-[120vh] flex items-center justify-center pt-32 pb-24 md:pt-40 md:pb-32 overflow-hidden px-6">
  <!-- Decorative background mesh/glows -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[40%] left-[50%] -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-accent-purple/10 rounded-full blur-[150px] transform rotate-12"></div>
    <div class="absolute top-[30%] left-[20%] w-[300px] h-[300px] bg-accent-cyan/15 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-6xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
    <!-- Left: Hero Intro -->
    <div class="lg:col-span-7 flex flex-col items-start text-left animate-fade-in-up">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full badge-tech text-xs font-semibold tracking-wider uppercase mb-6 border-accent-purple/20 bg-accent-purple/5">
        <span class="w-2 h-2 rounded-full bg-accent-cyan animate-pulse"></span>
        Disponible para proyectos Backend & Fullstack
      </div>
      
      <!-- Main Headline -->
      <h1 class="font-outfit text-5xl md:text-6xl lg:text-7xl font-black text-white leading-none mb-6 tracking-tight">
        Fer <br class="hidden sm:inline" />
        <span class="text-gradient-purple-cyan">Desarrollador Web Fullstack</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="font-inter text-gray-400 text-lg md:text-xl font-normal leading-relaxed max-w-xl mb-10">
        Especializado en el ecosistema <span class="text-white font-semibold">MERN</span> y <span class="text-white font-semibold">NestJS</span>, con una fuerte orientación al desarrollo <span class="text-gradient-cyan-blue font-bold">Backend</span>, diseño de APIs robustas y arquitecturas escalables.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
        <a 
          href="#projects" 
          class="w-full sm:w-auto text-center px-8 py-4 rounded-xl bg-gradient-to-r from-accent-purple to-accent-cyan text-bg-dark font-bold hover:shadow-lg hover:shadow-accent-purple/35 hover:-translate-y-0.5 transition-all duration-300"
        >
          Ver Proyectos
        </a>
        <a 
          href="#contact" 
          class="w-full sm:w-auto text-center px-8 py-4 rounded-xl glass text-white font-semibold border-white/10 hover:bg-white/5 hover:border-white/20 hover:-translate-y-0.5 transition-all duration-300"
        >
          Contactar
        </a>
      </div>
    </div>

    <!-- Right: Stylized Code Terminal for Backend showcase -->
    <div class="lg:col-span-5 w-full relative group">
      <!-- Glow effect behind terminal -->
      <div class="absolute -inset-1.5 bg-gradient-to-r from-accent-purple to-accent-cyan rounded-2xl blur opacity-30 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
      
      <!-- Terminal box -->
      <div class="relative w-full glass rounded-2xl overflow-hidden shadow-2xl border-white/10 text-xs sm:text-sm font-mono text-gray-300">
        <!-- Terminal Header -->
        <div class="bg-bg-dark/80 px-4 py-3 flex items-center justify-between border-b border-white/5">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
          </div>
          <span class="text-gray-500 text-xs select-none">user.controller.ts</span>
          <div class="w-12"></div> <!-- Spacer to center title -->
        </div>
        
        <!-- Terminal Body (Code) -->
        <div class="p-6 overflow-x-auto bg-bg-dark/45 space-y-2 select-text">
          <div>
            <span class="text-purple-400">@Controller</span>(<span class="text-green-300">'users'</span>)
          </div>
          <div>
            <span class="text-blue-400">export class</span> <span class="text-yellow-300">UserController</span> &#123;
          </div>
          <div class="pl-4 text-gray-500">
            // Inyección de dependencias
          </div>
          <div class="pl-4">
            <span class="text-blue-400">constructor</span>(
          </div>
          <div class="pl-8">
            <span class="text-blue-400">private readonly</span> <span class="text-cyan-400">userService</span>: <span class="text-yellow-300">UserService</span>
          </div>
          <div class="pl-4">
            ) &#123;&#125;
          </div>
          <br />
          <div class="pl-4">
            <span class="text-purple-400">@Post</span>()
          </div>
          <div class="pl-4">
            <span class="text-purple-400">@UsePipes</span>(<span class="text-blue-400">new</span> <span class="text-yellow-300">ValidationPipe</span>())
          </div>
          <div class="pl-4">
            <span class="text-purple-400">async</span> <span class="text-cyan-400">create</span>(
          </div>
          <div class="pl-8">
            <span class="text-purple-400">@Body</span>() <span class="text-cyan-400">createUserDto</span>: <span class="text-yellow-300">CreateUserDto</span>
          </div>
          <div class="pl-4">
            ) &#123;
          </div>
          <div class="pl-8">
            <span class="text-purple-400">return</span> <span class="text-blue-400">this</span>.<span class="text-cyan-400">userService</span>.<span class="text-cyan-400">register</span>(<span class="text-cyan-400">createUserDto</span>);
          </div>
          <div class="pl-4">
            &#125;
          </div>
          <div>&#125;</div>
        </div>
      </div>

      <!-- Tech stack floating tags behind/around -->
      <div class="absolute -bottom-6 -right-6 glass px-4 py-2 rounded-xl border-white/10 flex items-center gap-2 animate-float">
        <span class="w-3 h-3 rounded-full bg-red-500"></span>
        <span class="font-semibold text-xs text-white">NestJS Architecture</span>
      </div>
      <div class="absolute -top-6 -left-6 glass px-4 py-2 rounded-xl border-white/10 flex items-center gap-2 animate-float" style="animation-delay: -3s;">
        <span class="w-3 h-3 rounded-full bg-green-500"></span>
        <span class="font-semibold text-xs text-white">RESTful API Design</span>
      </div>
    </div>
  </div>
</section>
